{
  "name": "cat-trazabilidad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:http": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:upload": "tsx --env-file=.env.local scripts/test-upload-http.ts",
    "storage:reconcile": "tsx --env-file=.env.local scripts/reconcile-storage.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "backup:crypto": "node scripts/backup-crypto.mjs",
    "setup": "supabase start && npm run icons && npm run db:seed",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "exceljs": "^4.4.0",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.1",
    "next": "16.3.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/exceljs": "^0.5.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
