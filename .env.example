# Supabase local (npx supabase start)
# Este proyecto usa 55321+ para no chocar con otro stack local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-start
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-start

# Vacío para DEV local. Para seed remoto, incluir sólo el project ref de FINSA Staging.
ALLOWED_SEED_PROJECT_REFS=
# Defensa adicional; el ref productivo conocido también está bloqueado en código.
PRODUCTION_SUPABASE_PROJECT_REF=jbhbjazagiwyryujnenv

# Adapter de fotos: "supabase" | "r2" (default supabase).
EVIDENCE_STORAGE_PROVIDER=supabase

# Cloudflare R2 (requerido cuando EVIDENCE_STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cat-evidences
# R2_ENDPOINT opcional (default: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ENDPOINT=

# Error tracking: OFF by default. Do not add real values without separate approval.
ERROR_TRACKING_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
